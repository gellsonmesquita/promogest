# ---------- Desenvolvimento (npm run dev): copie para .env.local ----------
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# ---------- Docker / Coolify: no Coolify em "Environment Variables"; fora dele, num ficheiro .env ----------
PROMOGEST_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE
PROMOGEST_SESSION_SECRET=
# Porta publicada (só docker-compose.local.yml)
APP_PORT=3000
