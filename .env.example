# Copie para .env.local (desenvolvimento: npm run dev) ou .env (docker compose fora do Coolify).
# No Coolify, defina estas variáveis em "Environment Variables".

# Base de dados PostgreSQL (externa)
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE

# Chave para assinar as sessões (no Coolify é gerada automaticamente se ficar vazia).
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=

# true = carrega dados de demonstração no arranque, só se a BD estiver vazia
SEED_DEMO=false

# Porta publicada (só docker-compose.local.yml)
APP_PORT=3000
